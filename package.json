{
  "name": "codex-agent-map",
  "displayName": "Codex Agent Map",
  "description": "A first-party-style Codex App Server client for VS Code.",
  "version": "0.1.0",
  "publisher": "reganvannguyen",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexAgentMap.openWorkspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexAgentMap.openWorkspace",
        "title": "Codex Agent Map: Open Workspace"
      },
      {
        "command": "codexAgentMap.chooseCodexPath",
        "title": "Codex Agent Map: Choose Codex Executable"
      },
      {
        "command": "codexAgentMap.signIn",
        "title": "Codex Agent Map: Sign in with ChatGPT"
      },
      { "command": "codexAgentMap.initializeProjectMap", "title": "Codex Agent Map: Initialize Project Map" },
      { "command": "codexAgentMap.scanProjectArchitecture", "title": "Codex Agent Map: Scan Project Architecture" },
      { "command": "codexAgentMap.editProjectMap", "title": "Codex Agent Map: Edit Project Map" },
      { "command": "codexAgentMap.saveProjectLayout", "title": "Codex Agent Map: Save Project Layout" },
      { "command": "codexAgentMap.autoLayoutProject", "title": "Codex Agent Map: Auto Layout Project" },
      { "command": "codexAgentMap.resetAgentLayout", "title": "Codex Agent Map: Reset Agent Layout" },
      { "command": "codexAgentMap.fitVisualization", "title": "Codex Agent Map: Fit Visualization" },
      { "command": "codexAgentMap.runVisualizationDemo", "title": "Codex Agent Map: Run Visualization Demo" },
      { "command": "codexAgentMap.stopVisualizationDemo", "title": "Codex Agent Map: Stop Visualization Demo" },
      { "command": "codexAgentMap.showUnmappedActivity", "title": "Codex Agent Map: Show Unmapped Activity" },
      { "command": "codexAgentMap.openVisualWorkspace", "title": "Codex Agent Map: Open Visual Workspace" }
    ],
    "configuration": {
      "title": "Codex Agent Map",
      "properties": {
        "codexAgentMap.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Path to the Codex CLI executable."
        },
        "codexAgentMap.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log sanitized unknown protocol events."
        },
        "codexAgentMap.descendantPollIntervalMs": { "type": "number", "default": 1500, "minimum": 500, "maximum": 10000, "description": "Active descendant reconciliation interval." },
        "codexAgentMap.activityTrailDurationSeconds": { "type": "number", "default": 120, "minimum": 0, "maximum": 3600, "description": "How long completed activity connections remain visible." },
        "codexAgentMap.showInferredActivityEdges": { "type": "boolean", "default": true, "description": "Show evidence-based inferred activity edges." },
        "codexAgentMap.maxRecentComponentConnectionsPerAgent": { "type": "number", "default": 5, "minimum": 0, "maximum": 50, "description": "Maximum recent component trails retained for each agent." },
        "codexAgentMap.completedAgentDisplay": { "type": "string", "enum": ["show", "collapse", "activeOnly"], "default": "collapse", "description": "How completed runtime subagents are displayed." },
        "codexAgentMap.autoFitOnNewAgent": { "type": "boolean", "default": true, "description": "Fit the visualization when a new agent appears." },
        "codexAgentMap.projectMapPath": { "type": "string", "default": ".codex-agent-map/project-map.json", "description": "Workspace-relative project map configuration path." }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview-ui/tsconfig.json --noEmit",
    "lint": "eslint src webview-ui/src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:webview": "vite build --config webview-ui/vite.config.ts",
    "build": "npm run clean && npm run compile && npm run build:webview",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/vscode": "^1.96.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@xyflow/react": "^12.11.2",
    "dompurify": "^3.2.3",
    "marked": "^15.0.4",
    "minimatch": "^10.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
